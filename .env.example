# Frontend build defaults. Build args are also supported by Dockerfile.
# Keep VITE_BACKEND_ORIGIN on the same HTTPS site as the published Commander UI.
VITE_BACKEND_ORIGIN=https://cloudflare-manager.example.com
VITE_BACKEND_IMAGE=ghcr.io/your-org/cloudflare-manager:1.0.0
VITE_RUNNER_IMAGE=
VITE_CF_CLIENT_ID=replace-with-cloudflare-oauth-client-id
VITE_PUBLIC_ORIGIN=https://cloudflare-manager.example.com
VITE_COMMANDER_ORIGIN=https://commander.example.com

# Values for the Cloudflare Manager service, supplied by the install run.
CF_CLIENT_ID=replace-with-cloudflare-oauth-client-id
PUBLIC_ORIGIN=https://cloudflare-manager.example.com
COMMANDER_ORIGIN=https://commander.example.com
PORT=8080
STATIC_DIR=/app/frontend/dist

# Optional Deploy Commander publisher credentials for the CLI's local .env.
# These are never included in deploy-commander.json or the published bundle.
COMMANDER_URL=https://commander.example.com
COMMANDER_USERNAME=
COMMANDER_PASSWORD=

